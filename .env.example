# Copier en `.env` ou exporter ces variables avant `docker compose up -d`.

# Obligatoire : la clé du fournisseur de modèle retenu — l'une des deux, pas les deux.
# Par défaut Anthropic en direct :
ANTHROPIC_API_KEY=sk-ant-...

# Ou OpenRouter, passerelle hébergée devant les modèles de la plupart des fournisseurs.
# Décommenter ces trois lignes et laisser ANTHROPIC_API_KEY vide. À savoir : les prompts et les
# résultats d'outils transitent alors par un tiers, et l'agent exige un modèle sachant appeler
# des outils — tous ceux d'OpenRouter n'en sont pas capables.
# KEX_AGENT_LLM_PROVIDER=openai
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Obligatoire : bearer du serveur MCP de l'Explorer, partagé par les deux services.
# Générer avec : openssl rand -hex 32
EXPLORER_MCP_AUTH_TOKEN=

# Obligatoire : bearer exigé par l'agent sur /api/**.
# Générer avec : openssl rand -hex 32
KEX_AGENT_API_KEY=

# Optionnels
# EXPLORER_IMAGE_TAG=2.0.3           # version épinglée ; `latest` pour suivre les publications
# EXPLORER_IMAGE_NAMESPACE=compagnonsdudev   # ou ghcr.io/devdownin
# EXPLORER_MCP_READONLY=true
# BIND_ADDR=127.0.0.1                # 0.0.0.0 pour exposer hors de la machine
# EXPLORER_PORT=8080
# KEX_AGENT_PORT=8081
# KAFKA_PORT=9092
# POSTGRES_PASSWORD=kex             # surcouche compose/shared-memory.yml
